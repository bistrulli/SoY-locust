# =============================================================================
# SoY-locust — central configuration
#
# One place to manage the two machines (load + app), their ports, the derived
# endpoints, the measurement defaults and the reproducibility knobs. Sourced
# automatically by `xp.sh`. For direct use of `python run_experiment.py`
# (without xp.sh), run `source config.env` first.
#
# Every value uses ${VAR:-default}, so an environment variable set beforehand
# still wins, e.g.:   APP_HOST=10.0.0.9 ./xp.sh go
# =============================================================================

# --- Machines ----------------------------------------------------------------
export LOAD_HOST="${LOAD_HOST:-192.168.3.101}"            # runs xp.sh, the harness and Locust
export APP_HOST="${APP_HOST:-192.168.3.102}"              # remote Docker daemon + Scaphandre (RAPL)
export WATTMETER_HOST="${WATTMETER_HOST:-192.168.3.131}"  # Tasmota plug (wall power)

# --- Ports on the app machine ------------------------------------------------
export DOCKER_PORT="${DOCKER_PORT:-2375}"                 # remote Docker API
export SCAPHANDRE_PORT="${SCAPHANDRE_PORT:-9999}"         # Scaphandre Prometheus exporter

# --- Endpoints (derived from the above; override directly if your setup differs)
export BENCH_APP_HOST="${BENCH_APP_HOST:-$APP_HOST}"                      # Locust --host target
export DOCKER_HOST="${DOCKER_HOST:-tcp://$APP_HOST:$DOCKER_PORT}"
export SCAPHANDRE_URL="${SCAPHANDRE_URL:-http://$APP_HOST:$SCAPHANDRE_PORT/metrics}"
export WATTMETER_HTTP="${WATTMETER_HTTP:-http://$WATTMETER_HOST}"         # empty => wattmeter disabled

# --- Source sync (dev box -> machines), used by `./xp.sh sync` ---------------
export LOAD_DIR="${LOAD_DIR:-SoY-locust}"                 # target dir under $HOME on both machines

# --- Measurement -------------------------------------------------------------
export SYS_SOURCE="${SYS_SOURCE:-docker}"                 # app system metrics: docker | psutil | auto
export METRICS_SAMPLE_S="${METRICS_SAMPLE_S:-1.0}"        # sampling step (s)

# --- Energy sources: set to 0 to run cleanly with NO endpoint ----------------
export RAPL_ENABLED="${RAPL_ENABLED:-1}"                  # 0 => no Scaphandre/RAPL (skips sysfs too)
export WATTMETER_ENABLED="${WATTMETER_ENABLED:-1}"        # 0 => no Tasmota wattmeter

# --- Reproducibility ----------------------------------------------------------
# Pin every source of variability so a re-run produces the SAME offered load:
# same users (deterministic pick, seeded), same per-user rate, same load shape.
export BENCH_SEED="${BENCH_SEED:-42}"                     # seeds Python random in the locustfiles
export BENCH_RPS_PER_USER="${BENCH_RPS_PER_USER:-1.0}"    # offered iterations/s per user (constant throughput)
# cyclical loadshape phase durations (deterministic timing): 5 x (30+60+30=120s) = 600s
export SHAPE_RAMP_S="${SHAPE_RAMP_S:-30}"
export SHAPE_PLATEAU_S="${SHAPE_PLATEAU_S:-60}"
export SHAPE_PAUSE_S="${SHAPE_PAUSE_S:-30}"
export SHAPE_CYCLES="${SHAPE_CYCLES:-5}"

# --- Single test (`./xp.sh test` runs ONE configured experiment) -------------
export TEST_INFRA="${TEST_INFRA:-monolith-v5}"           # monolith-v4 | monolith-v5 | microservices-demo
export TEST_CONTROLLER="${TEST_CONTROLLER:-none}"        # none | manual | manual-sched | uopt | hpa
export TEST_VARIANT="${TEST_VARIANT:-}"                  # empty => infra default (e.g. go|python|java|csharp)
export TEST_USERS="${TEST_USERS:-100}"
export TEST_RUN_TIME="${TEST_RUN_TIME:-120s}"
